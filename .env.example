# LOCALORA - Environment Configuration Example
# Copy this file to .env and adjust values for local development.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=super_secret_localora_jwt_key_minimum_32_characters_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DATABASE_PATH=./data/localora.sqlite

# Administrative Bootstrap Secret
ADMIN_BOOTSTRAP_TOKEN=localora_admin_bootstrap_secret_2026

# Payment Gateway Configuration
# Mode: 'demo' (safe simulated sandbox for testing without credentials) or 'razorpay'
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret_for_signing

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@localora.in
SMTP_PASS=placeholder
