frontend/public/uploads/*
frontend/public/uploads/**/*
!frontend/public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
