# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Environment and Secret files
.env
.env.*
*.env
!.env.example

# Local SQLite databases & backups
data/*
data/**/*
!data/.gitkeep
backend/data/*
backend/data/**/*
!backend/data/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
*.db-journal
*.backup*

# Build outputs
dist/
*/dist/
**/dist/
build/
.turbo/
coverage/

# User-uploaded dynamic files
backend/uploads/*
backend/uploads/**/*
